# -----------------------------------------------------------------------------
# Social Media Video Downloader - Environment Configuration Example
# Copy this file to '.env' or '.env.local' and set values as needed.
# -----------------------------------------------------------------------------

# Port or node environment settings (optional)
# NODE_ENV=development
# PORT=3000

# Path to the yt-dlp binary. If yt-dlp is installed globally in the system path, 
# you can leave this empty or commented out.
# YTDLP_PATH=yt-dlp

# --- PROXY ROTATION CONFIGURATION (OPTIONAL) ---
# If no proxy is specified, the application will use the host server's default IP.

# PROXY_URL: Single proxy configuration.
# Format: protocol://[username:password@]ip:port (e.g. http://myuser:mypass@12.34.56.78:8080)
# PROXY_URL=http://username:password@1.2.3.4:8080

# PROXY_LIST: A list of proxies for rotation.
# Can be comma-separated, semicolon-separated, or newline-separated.
# If both PROXY_URL and PROXY_LIST are defined, the rotation engine pools both sets together
# and picks one randomly per request.
# PROXY_LIST=http://user:pass@111.111.111.111:8080,socks5://222.222.222.222:1080,http://333.333.333.333:8080

# --- ANALYTICS CONFIGURATION ---
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- ZM API CONFIGURATION ---
# ZM API Key for All-in-One Social Downloader
ZM_API_KEY=your_actual_api_key_here
# ZM API Base URL
ZM_API_BASE_URL=https://api.zm.io.vn/v1/social/autolink


